# --- Site ---------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, sitemap, OG, e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only "production" is indexable. Anything else (preview, staging, local) is noindex.
NEXT_PUBLIC_SITE_ENV=development

# --- Supabase (Project Settings -> API) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Needed for newsletter, analytics, account deletion, rate limiting.
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail (newsletter double opt-in) ----------------------------------
# Auth e-mails (verification, password reset) are sent by Supabase Auth: configure SMTP there.
RESEND_API_KEY=
EMAIL_FROM="HeistMatch <hello@heistmatch.com>"

# --- Security -----------------------------------------------------------
# Random secret used to hash IPs for rate limiting (raw IPs are never stored).
RATE_LIMIT_SALT=change-me

# --- Optional -----------------------------------------------------------
# Extra hosts allowed for next/image (comma separated). The Supabase host is added automatically.
NEXT_PUBLIC_IMAGE_HOSTS=
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
